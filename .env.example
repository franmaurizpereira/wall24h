# Entorno de desarrollo
NODE_ENV=development
PORT=3000

# Puertos publicados por docker compose
POSTGRES_PORT=5433
APP_PORT=8080
APP_TEST_PORT=8081
TEST_BASE_URL=http://localhost:8081

# Password del usuario wall dentro del contenedor PostgreSQL.
# Usa solo letras/números para evitar URL-encoding.
DB_PASSWORD=cambia-esto-por-una-password-url-safe

# Secretos distintos para desarrollo y tests.
COOKIE_SECRET=cambia-esto-por-openssl-rand-hex-32
TEST_COOKIE_SECRET=cambia-esto-por-otro-openssl-rand-hex-32

# Herramientas en el host: psql, Playwright, scripts.
# TU_PASSWORD debe coincidir con DB_PASSWORD, codificada si hace falta.
DATABASE_URL=postgresql://wall:TU_PASSWORD@localhost:5433/wall
TEST_DATABASE_URL=postgresql://wall:TU_PASSWORD@localhost:5433/wall_test
