{
  "$schema": "https://opencode.ai/config.json",
	"mcp": {
	  "context7": {
	    "type": "remote",
	    "url": "https://mcp.context7.com/mcp",
	    "headers": {
	      "Authorization": "Bearer $API_KEY_CONTEXT7"
	    },
	    "enabled": true
	  },
	  "mcp": {
        "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"],
        "enabled": true
        }
      },
      "servers": {
        "playwright": {
          "type": "local",
          "command": [
            "npx",
            "@playwright/mcp@latest"
          ]
        }
      }
	}
}
