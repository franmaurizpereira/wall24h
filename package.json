{
  "name": "wall24h",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ecco — muro efímero de mensajes de 24 horas",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "npm run typecheck",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:up": "node --env-file-if-exists=.env scripts/with-env.mjs bash scripts/test-up.sh",
    "test:down": "node --env-file-if-exists=.env scripts/with-env.mjs bash scripts/test-down.sh",
    "test:api": "playwright test --project=api",
    "test:db": "playwright test --project=db",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:unit": "vitest run",
    "test:all": "node --env-file-if-exists=.env scripts/with-env.mjs bash scripts/test-all.sh",
    "db:migrate": "node --env-file-if-exists=.env scripts/with-env.mjs bash scripts/migrate.sh",
    "db:migrate:test": "node --env-file-if-exists=.env scripts/with-env.mjs bash scripts/migrate-test.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
